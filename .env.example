# 复制为 .env 后按需修改（docker compose 会自动读取）

# 对外端口
IPAN_PORT=8080
TZ=Asia/Shanghai

# 反向代理（Nginx / Traefik / Caddy）后面部署时设为 true，
# 用于读取 X-Forwarded-Proto / X-Forwarded-Host。
# Passkey 需要外部域名，也必须打开它才能拿到正确的 RP ID。
IPAN_TRUST_PROXY=false

# 生成分享链接时使用的站点地址。留空则根据请求自动推断；
# 反向代理场景建议显式指定，避免生成 http://内网地址 的链接。
# IPAN_PUBLIC_URL=https://pan.example.com

# WebDAV（/dav/）。同时设置独立的用户名和口令后启用。
# IPAN_WEBDAV_USER=webdav
# IPAN_WEBDAV_PASSWORD=

# ---- 以下均为可选：首次启动时作为预置值写入数据库 ----

# 访问密码。留空则首次打开页面时引导设置。
# APP_TOKEN=

# 文件床签名密钥。留空则自动随机生成并保存。
# SIGN_PARAM=

# 云盘令牌。也可在页面上用手机号 + 短信验证码登录后自动写入。
# WOPAN_ACCESS_TOKEN=
# WOPAN_REFRESH_TOKEN=

# 云盘接口地址
# WOPAN_BASE_URL=https://panservice.mail.wo.cn
# WOPAN_ZONE_URL=https://tjupload.pan.wo.cn

# 0 = 个人空间，1 = 家庭空间（需同时设置 WOPAN_FAMILY_ID）
# WOPAN_SPACE_TYPE=0
# WOPAN_FAMILY_ID=

# 令牌保活检查间隔（小时），设为 0 关闭后台保活
# TOKEN_CHECK_INTERVAL_HOURS=1
